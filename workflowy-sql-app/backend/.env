# Configuración para modo JSON (sin MySQL)
# Datos se guardan en consultas-data.json

# Puerto del servidor
PORT=3000

# Entorno
NODE_ENV=development

# Modo de almacenamiento
# Deja estos comentados para usar JSON
# USE_MYSQL=false

# Para MySQL (descomenta y configura si lo necesitas):
# MYSQL_URL=mysql://tu_usuario:tu_password@localhost:3306/queryvault_db
# O variables individuales:
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=tu_password
# DB_NAME=queryvault_db
# DB_PORT=3306